POSTRES = []

# Buscar postre
def buscar_postre(nombre):
    for postre in POSTRES:
        if postre["nombre"].lower() == nombre.lower():
            return postre
    return None

# a) Mostrar ingredientes
def mostrar_ingredientes():
    nombre = input("Nombre del postre: ")
    postre = buscar_postre(nombre)
    
    if postre:
        if postre["ingredientes"]:
            print("Ingredientes:", ", ".join(postre["ingredientes"]))
        else:
            print("El postre no tiene ingredientes registrados.")
    else:
        print("El postre no existe.")

# b) Insertar ingrediente
def agregar_ingrediente():
    nombre = input("Nombre del postre: ")
    postre = buscar_postre(nombre)
    
    if postre:
        ingrediente = input("Nuevo ingrediente: ")
        if ingrediente in postre["ingredientes"]:
            print("El ingrediente ya existe.")
        else:
            postre["ingredientes"].append(ingrediente)
            print("Ingrediente agregado.")
    else:
        print("El postre no existe.")

# c) Eliminar ingrediente
def eliminar_ingrediente():
    nombre = input("Nombre del postre: ")
    postre = buscar_postre(nombre)
    
    if postre:
        ingrediente = input("Ingrediente a eliminar: ")
        if ingrediente in postre["ingredientes"]:
            postre["ingredientes"].remove(ingrediente)
            print("Ingrediente eliminado.")
        else:
            print("El ingrediente no existe.")
    else:
        print("El postre no existe.")

# d) Alta de postre
def agregar_postre():
    nombre = input("Nombre del postre: ")
    
    if buscar_postre(nombre):
        print("El postre ya existe.")
        return
    
    ingredientes = input("Ingredientes (separados por coma): ").split(",")
    ingredientes = [i.strip() for i in ingredientes]
    
    POSTRES.append({
        "nombre": nombre,
        "ingredientes": ingredientes
    })
    
    POSTRES.sort(key=lambda x: x["nombre"].lower())
    print("Postre agregado correctamente.")

# e) Baja de postre
def eliminar_postre():
    nombre = input("Nombre del postre: ")
    postre = buscar_postre(nombre)
    
    if postre:
        POSTRES.remove(postre)
        print("Postre eliminado.")
    else:
        print("El postre no existe.")

# 🔹 NUEVA FUNCIÓN: eliminar repetidos
def eliminar_repetidos():
    global POSTRES
    nombres_vistos = set()
    nuevos_postres = []

    for postre in POSTRES:
        nombre = postre["nombre"].lower()

        if nombre not in nombres_vistos:
            nombres_vistos.add(nombre)
            nuevos_postres.append(postre)

    POSTRES = nuevos_postres
    print("Postres repetidos eliminados.")

# Menú
def menu():
    while True:
        print("\n--- MENÚ ---")
        print("1. Mostrar ingredientes")
        print("2. Agregar ingrediente")
        print("3. Eliminar ingrediente")
        print("4. Agregar postre")
        print("5. Eliminar postre")
        print("6. Eliminar postres repetidos")
        print("7. Salir")
        
        opcion = input("Seleccione una opción: ")
        
        if opcion == "1":
            mostrar_ingredientes()
        elif opcion == "2":
            agregar_ingrediente()
        elif opcion == "3":
            eliminar_ingrediente()
        elif opcion == "4":
            agregar_postre()
        elif opcion == "5":
            eliminar_postre()
        elif opcion == "6":
            eliminar_repetidos()
        elif opcion == "7":
            print("Saliendo...")
            break
        else:
            print("Opción inválida.")

# Ejecutar
menu()
