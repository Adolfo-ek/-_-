# PRUEBAS
# ============================================

if __name__ == "__main__":

    numeros = [38, 27, 43, 3, 9, 82, 10]

    palabras = ["rojo", "azul", "verde", "amarillo"]

    print("\nNÚMEROS:")
    print(merge_sort(numeros))

    print("\nNÚMEROS DESC:")
    print(merge_sort(numeros, ascendente=False))

    print("\nPALABRAS:")
    print(merge_sort(palabras))

    print("\nPALABRAS DESC:")
    print(merge_sort(palabras, ascendente=False))

