# ============================================
# BUBBLE SORT
# ============================================

def burbuja(datos):

    n = len(datos)

    for i in range(n):

        for j in range(0, n - i - 1):

            if datos[j] > datos[j + 1]:

                datos[j], datos[j + 1] = (
                    datos[j + 1],
                    datos[j]
                )

    return datos


# ============================================
# PRUEBA
# ============================================

if __name__ == "__main__":

    numeros = [
        64,
        34,
        25,
        12,
        22,
        11,
        90
    ]

    print("Original:")
    print(numeros)

    resultado = burbuja(
        numeros.copy()
    )

    print("\nOrdenado:")
    print(resultado)
