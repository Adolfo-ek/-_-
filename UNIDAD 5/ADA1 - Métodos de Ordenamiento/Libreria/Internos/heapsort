if __name__ == "__main__":

    numeros = [12, 11, 13, 5, 6, 7]

    palabras = ["kiwi", "manzana", "banana", "uva"]

    print("\nNÚMEROS:")
    print(heap_sort(numeros))

    print("\nNÚMEROS DESC:")
    print(heap_sort(numeros, ascendente=False))

    print("\nPALABRAS:")
    print(heap_sort(palabras))

    print("\nPALABRAS DESC:")
    print(heap_sort(palabras, ascendente=False))

