# ============================================
# LIBRERÍA HEAP SORT
# ============================================

def heap_sort(datos, ascendente=True):
    """
    Ordenamiento Heap Sort.
    """

    arr = datos.copy()

    n = len(arr)

    # ========================================
    # HEAPIFY
    # ========================================

    def heapify(arr, n, i):

        extremo = i

        izquierda = 2 * i + 1

        derecha = 2 * i + 2

        # Ascendente -> Max Heap
        if ascendente:

            if izquierda < n and arr[izquierda] > arr[extremo]:

                extremo = izquierda

            if derecha < n and arr[derecha] > arr[extremo]:

                extremo = derecha

        # Descendente -> Min Heap
        else:

            if izquierda < n and arr[izquierda] < arr[extremo]:

                extremo = izquierda

            if derecha < n and arr[derecha] < arr[extremo]:

                extremo = derecha

        if extremo != i:

            arr[i], arr[extremo] = arr[extremo], arr[i]

            heapify(arr, n, extremo)

    # ========================================
    # CONSTRUIR HEAP
    # ========================================

    for i in range(n // 2 - 1, -1, -1):

        heapify(arr, n, i)

    # ========================================
    # EXTRAER ELEMENTOS
    # ========================================

    for i in range(n - 1, 0, -1):

        arr[i], arr[0] = arr[0], arr[i]

        heapify(arr, i, 0)

    return arr


