# LIBRERÍA SHELL SORT
# ============================================

def shell_sort(datos, ascendente=True):
    """
    Ordenamiento Shell Sort.
    """

    arr = datos.copy()

    n = len(arr)

    gap = n // 2

    while gap > 0:

        for i in range(gap, n):

            temp = arr[i]

            j = i

            # Ascendente
            if ascendente:

                while j >= gap and arr[j - gap] > temp:

                    arr[j] = arr[j - gap]

                    j -= gap

            # Descendente
            else:

                while j >= gap and arr[j - gap] < temp:

                    arr[j] = arr[j - gap]

                    j -= gap

            arr[j] = temp

        gap //= 2

    return arr


