# ============================================
# LIBRERÍA DE ORDENAMIENTO POR INSERCIÓN
# ============================================

def insertion_sort(datos, ascendente=True):
    """
    Ordenamiento por Inserción.

    Parámetros:
    datos -> lista de elementos
    ascendente -> True o False

    Retorna:
    lista ordenada
    """

    arr = datos.copy()

    for i in range(1, len(arr)):

        actual = arr[i]

        j = i - 1

        # Ascendente
        if ascendente:

            while j >= 0 and arr[j] > actual:

                arr[j + 1] = arr[j]

                j -= 1

        # Descendente
        else:

            while j >= 0 and arr[j] < actual:

                arr[j + 1] = arr[j]

                j -= 1

        arr[j + 1] = actual

    return arr


