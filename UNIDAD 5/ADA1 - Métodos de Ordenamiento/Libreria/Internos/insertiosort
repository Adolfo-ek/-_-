if __name__ == "__main__":

    numeros = [9, 4, 7, 1, 3]

    palabras = ["zorro", "abeja", "perro", "gato"]

    print("\nNÚMEROS:")
    print(insertion_sort(numeros))

    print("\nNÚMEROS DESC:")
    print(insertion_sort(numeros, ascendente=False))

    print("\nPALABRAS:")
    print(insertion_sort(palabras))

    print("\nPALABRAS DESC:")
    print(insertion_sort(palabras, ascendente=False))

