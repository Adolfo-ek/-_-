from tkinter import ttk
from tkinter import messagebox
from tkinter import filedialog

import time
import matplotlib.pyplot as plt

from busqueda.busqueda_secuencial import (
    busqueda_secuencial
)

from busqueda.busqueda_binaria import (
    busqueda_binaria
)

from busqueda.tabla_hash import (
    TablaHash
)

# =========================================
# LECTORES
# =========================================

from archivos.leer_txt import leer_txt
from archivos.leer_csv import leer_csv
from archivos.leer_excel import leer_excel
from archivos.leer_json import leer_json
from archivos.leer_word import leer_word


class InterfazBusquedas:

    def __init__(self, root):

        self.root = root

        self.datos_cargados = []

        self.posiciones = []

        self.tiempos = []

        # =====================================
        # CONFIG
        # =====================================

        self.root.title(
            "Sistema de Busquedas"
        )

        self.root.geometry(
            "1600x950"
        )

        self.root.configure(
            bg="#020617"
        )

        # =====================================
