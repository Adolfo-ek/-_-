import tkinter as tk
from tkinter import messagebox


class InterfazComparador:

    def __init__(self, root):

        self.root = root

        # =====================================
        # CONFIG
        # =====================================

        self.root.title(
            "Comparador Global"
        )

        self.root.geometry(
            "1400x850"
        )

        self.root.minsize(
            1100,
            700
        )

        self.root.configure(
            bg="#020617"
        )

        # =====================================
        # GRID ROOT
        # =====================================

        self.root.grid_rowconfigure(
            1,
            weight=1
        )

        self.root.grid_columnconfigure(
            0,
            weight=1
        )

        # =====================================
        # HEADER
        # =====================================

        header = tk.Frame(
            root,
            bg="#0f172a",
            height=110
        )

        header.grid(
            row=0,
            column=0,
            sticky="ew"
        )

        header.grid_propagate(False)

        titulo = tk.Label(

            header,

            text="COMPARADOR GLOBAL",

            font=(
                "Segoe UI",
                30,
                "bold"
            ),

            bg="#0f172a",

            fg="#f97316"
        )

        titulo.pack(
            pady=(20, 5)
        )

        subtitulo = tk.Label(

            header,

            text="Sistema General de Comparaciones y Analisis",

            font=(
                "Segoe UI",
                12
            ),

            bg="#0f172a",

            fg="#cbd5e1"
        )

        subtitulo.pack()

        # =====================================
        # MAIN
        # =====================================

        main = tk.Frame(
            root,
            bg="#020617"
        )

        main.grid(
            row=1,
            column=0,
            sticky="nsew",
            padx=30,
            pady=30
        )

        # =====================================
        # GRID RESPONSIVE
        # =====================================

        for i in range(2):

            main.grid_columnconfigure(
                i,
                weight=1,
                uniform="col"
            )

            main.grid_rowconfigure(
                i,
                weight=1,
                uniform="row"
            )

        # =====================================
        # CREATE CARD
        # =====================================

        def crear_card(

            row,
            column,
            titulo,
            descripcion,
            color
        ):

            card = tk.Frame(
                main,
                bg="#111827",
                highlightbackground="#1e293b",
                highlightthickness=2
            )

            card.grid(
                row=row,
                column=column,
                padx=20,
                pady=20,
                sticky="nsew"
            )

            card.grid_rowconfigure(
                0,
                weight=2
            )

            card.grid_rowconfigure(
                1,
                weight=1
            )

            card.grid_rowconfigure(
                2,
                weight=1
            )

            card.grid_columnconfigure(
                0,
                weight=1
            )

            titulo_label = tk.Label(

                card,

                text=titulo,

                font=(
                    "Segoe UI",
                    22,
                    "bold"
                ),

                bg="#111827",

                fg=color,

                justify="center"
            )

            titulo_label.grid(
                row=0,
                column=0,
                pady=(30, 10),
                sticky="s"
            )

            descripcion_label = tk.Label(

                card,

                text=descripcion,

                font=(
                    "Segoe UI",
                    11
                ),

                bg="#111827",

                fg="white",

                wraplength=320,

                justify="center"
            )

            descripcion_label.grid(
                row=1,
                column=0,
                padx=30,
                sticky="n"
            )

            boton = tk.Button(

                card,

                text="ABRIR",

                font=(
                    "Segoe UI",
                    12,
                    "bold"
                ),

                bg=color,

                fg="black",

                relief="flat",

                width=16,

                height=2,

                cursor="hand2",

                command=self.modulo_futuro
            )

            boton.grid(
                row=2,
                column=0,
                pady=(10, 30)
            )

        # =====================================
        # CARDS
        # =====================================

        crear_card(

            0,
            0,

            "COMPARADOR\nINTERNOS",

            "Comparacion de algoritmos "
            "internos con graficas y "
            "estadisticas.",

            "#38bdf8"
        )

        crear_card(

            0,
            1,

            "COMPARADOR\nEXTERNOS",

            "Comparacion profesional "
            "de algoritmos externos "
            "y rendimiento.",

            "#22c55e"
        )

        crear_card(

            1,
            0,

            "ANALISIS\nGENERAL",

            "Analisis de rendimiento "
            "global y comportamiento "
            "de algoritmos.",

            "#f97316"
        )

        crear_card(

            1,
            1,

            "GRAFICAS\nAVANZADAS",

            "Graficas profesionales "
            "de tiempos y eficiencia.",

            "#a855f7"
        )

    # =====================================
    # FUTURE MODULE
    # =====================================

    def modulo_futuro(self):

        messagebox.showinfo(
            "Modulo",
            "Modulo en desarrollo."
        )


# =========================================
# MAIN
# =========================================

if __name__ == "__main__":

    root = tk.Tk()

    app = InterfazComparador(root)

    root.mainloop()
