import tkinter as tk
import subprocess
import sys


class InterfazMaestra:

    def __init__(self, root):

        self.root = root

        # =====================================
        # CONFIG
        # =====================================

        self.root.title(
            "Sorting Professional Hub"
        )

        self.root.geometry(
            "1700x1050"
        )

        self.root.minsize(
            1450,
            900
        )

        self.root.configure(
            bg="#020617"
        )

        # =====================================
        # GRID ROOT
        # =====================================

        self.root.grid_rowconfigure(
            1,
            weight=1
        )

        self.root.grid_columnconfigure(
            0,
            weight=1
        )

        # =====================================
        # HEADER
        # =====================================

        header = tk.Frame(
            root,
            bg="#0f172a",
            height=140
        )

        header.grid(
            row=0,
            column=0,
            sticky="ew"
        )

        header.grid_propagate(False)

        titulo = tk.Label(

            header,

            text="SORTING PROFESSIONAL HUB",

            font=(
                "Segoe UI",
                36,
                "bold"
            ),

            bg="#0f172a",

            fg="#38bdf8"
        )

        titulo.pack(
            pady=(25, 8)
        )

        subtitulo = tk.Label(

            header,

            text="Sistema Integral de Ordenamientos, Busquedas y Analisis",

            font=(
                "Segoe UI",
                15
            ),

            bg="#0f172a",

            fg="#94a3b8"
        )

        subtitulo.pack()

        # =====================================
        # MAIN CONTAINER
        # =====================================

        contenedor = tk.Frame(
            root,
            bg="#020617"
        )

        contenedor.grid(
            row=1,
            column=0,
            sticky="nsew",
            padx=35,
            pady=35
        )

        # =====================================
        # GRID RESPONSIVE
        # =====================================

        for i in range(3):

            contenedor.grid_columnconfigure(
                i,
                weight=1,
                uniform="col"
            )

        for i in range(2):

            contenedor.grid_rowconfigure(
                i,
                weight=1,
                uniform="row",
                minsize=340
            )

        # =====================================
        # CARD CREATOR
        # =====================================

        def crear_tarjeta(

            row,
            column,
            titulo,
            descripcion,
            color,
            comando
        ):

            tarjeta = tk.Frame(

                contenedor,

                bg="#111827",

                highlightthickness=2,

                highlightbackground="#1e293b",

                bd=0
            )

            tarjeta.grid(

                row=row,

                column=column,

                padx=18,

                pady=18,

                sticky="nsew"
            )

            tarjeta.grid_rowconfigure(
                0,
                weight=2
            )

            tarjeta.grid_rowconfigure(
                1,
                weight=1
            )

            tarjeta.grid_rowconfigure(
                2,
                weight=1
            )

            tarjeta.grid_columnconfigure(
                0,
                weight=1
            )

            # =================================
            # TITULO
            # =================================

            titulo_label = tk.Label(

                tarjeta,

                text=titulo,

                font=(
                    "Segoe UI",
                    18,
                    "bold"
                ),

                bg="#111827",

                fg=color,

                justify="center"
            )

            titulo_label.grid(
                row=0,
                column=0,
                pady=(50, 20),
                sticky="s"
            )

            # =================================
            # DESCRIPCION
            # =================================

            descripcion_label = tk.Label(

                tarjeta,

                text=descripcion,

                font=(
                    "Segoe UI",
                    11
                ),

                bg="#111827",

                fg="#e2e8f0",

                wraplength=320,

                justify="center"
            )

            descripcion_label.grid(
                row=1,
                column=0,
                padx=25,
                sticky="n"
            )

            # =================================
            # BOTON
            # =================================

            boton = tk.Button(

                tarjeta,

                text="ABRIR MODULO",

                font=(
                    "Segoe UI",
                    11,
                    "bold"
                ),

                bg=color,

                fg="black",

                relief="flat",

                activebackground=color,

                cursor="hand2",

                width=18,

                height=3,

                command=comando
            )

            boton.grid(
                row=2,
                column=0,
                pady=(15, 35)
            )

        # =====================================
        # FILA 1
        # =====================================

        crear_tarjeta(

            0,
            0,

            "ORDENAMIENTOS\nINTERNOS",

            "Visualizacion profesional "
            "de algoritmos internos "
            "con animaciones.",

            "#38bdf8",

            self.abrir_internos
        )

        crear_tarjeta(

            0,
            1,

            "ORDENAMIENTOS\nEXTERNOS",

            "Intercalacion, mezcla "
            "directa, equilibrada "
            "y polifase.",

            "#22c55e",

            self.abrir_externos
        )

        crear_tarjeta(

            0,
            2,

            "COMPARADORES\nY ANALISIS",

            "Comparativas visuales "
            "y medicion de rendimiento.",

            "#f97316",

            self.abrir_comparador
        )

        # =====================================
        # FILA 2
        # =====================================

        crear_tarjeta(

            1,
            0,

            "REPORTES\nY DASHBOARDS",

            "Graficas avanzadas "
            "e historial global.",

            "#a855f7",

            self.abrir_dashboard
        )

        crear_tarjeta(

            1,
            1,

            "BENCHMARK\nPROFESIONAL",

            "Pruebas masivas "
            "y ranking automatico.",

            "#facc15",

            self.abrir_benchmark
        )

        crear_tarjeta(

            1,
            2,

            "BUSQUEDAS\nACADEMICAS",

            "Busqueda Secuencial, "
            "Binaria y Tabla Hash.",

            "#f59e0b",

            self.abrir_busquedas
        )

        # =====================================
        # FOOTER
        # =====================================

        footer = tk.Label(

            root,

            text="Proyecto Profesional de Estructura de Datos • Python",

            font=(
                "Segoe UI",
                10
            ),

            bg="#020617",

            fg="#64748b"
        )

        footer.grid(
            row=2,
            column=0,
            pady=(0, 15)
        )

    # =====================================
    # OPEN MODULES
    # =====================================

    def abrir_internos(self):

        subprocess.Popen([
            sys.executable,
            "-m",
            "interfaces.interfaz_principal"
        ])

    def abrir_externos(self):

        subprocess.Popen([
            sys.executable,
            "-m",
            "interfaces.interfaz_externa"
        ])

    def abrir_comparador(self):

        subprocess.Popen([
            sys.executable,
            "-m",
            "interfaces.interfaz_comparador"
        ])

    def abrir_dashboard(self):

        subprocess.Popen([
            sys.executable,
            "-m",
            "interfaces.interfaz_dashboard"
        ])

    def abrir_benchmark(self):

        subprocess.Popen([
            sys.executable,
            "-m",
            "interfaces.interfaz_benchmark"
        ])

    def abrir_busquedas(self):

        subprocess.Popen([
            sys.executable,
            "-m",
            "interfaces.interfaz_busquedas"
        ])


# =========================================
# MAIN
# =========================================

if __name__ == "__main__":

    root = tk.Tk()

    app = InterfazMaestra(root)

    root.mainloop()
