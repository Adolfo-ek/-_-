        )

    # =====================================
    # EXPORT
    # =====================================

    def guardar_txt(self):

        if self.resultado_actual:
            exportar_txt(
                self.resultado_actual
            )

    def guardar_csv(self):

        if self.resultado_actual:
            exportar_csv(
                self.resultado_actual
            )

    def guardar_excel(self):

        if self.resultado_actual:
            exportar_excel(
                self.resultado_actual
            )

    # =====================================
    # COMPARATOR
    # =====================================

    def comparar_algoritmos(self):

        datos = self.obtener_datos()

        resultados = medir_tiempos(
            datos
        )

        mostrar_grafica(
            resultados
        )


if __name__ == "__main__":

    root = tk.Tk()

    app = InterfazInterna(root)

    root.mainloop()
