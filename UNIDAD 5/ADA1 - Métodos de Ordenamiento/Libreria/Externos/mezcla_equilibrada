import os


# =========================================
# LEER ARCHIVO UNIVERSAL
# =========================================

def leer_archivo(ruta):

    from archivos.leer_txt import leer_txt
    from archivos.leer_csv import leer_csv
    from archivos.leer_excel import leer_excel
    from archivos.leer_json import leer_json
    from archivos.leer_word import leer_word

    if ruta.endswith(".txt"):

        datos = leer_txt(ruta)

    elif ruta.endswith(".csv"):

        datos = leer_csv(ruta)

    elif ruta.endswith(".xlsx"):

        datos = leer_excel(ruta)

    elif ruta.endswith(".json"):

        datos = leer_json(ruta)

    elif ruta.endswith(".docx"):

        datos = leer_word(ruta)

    else:

        raise ValueError(
            "Formato no soportado"
        )

    resultado = []

    for dato in datos:

        try:

            resultado.append(
                int(float(dato))
            )

        except:
            pass

    return resultado


# =========================================
# ESCRIBIR ARCHIVO
# =========================================

def escribir_archivo(ruta, datos):

    with open(
        ruta,
        "w",
        encoding="utf-8"
    ) as archivo:

        for numero in datos:

            archivo.write(
                f"{numero}\n"
            )


# =========================================
# DETECTAR CORRIDAS
# =========================================

def detectar_corridas(datos, logs):

    corridas = []

    corrida_actual = [
        datos[0]
    ]

    for i in range(
        1,
        len(datos)
    ):

        if datos[i] >= datos[i - 1]:

            corrida_actual.append(
                datos[i]
            )

        else:

            corridas.append(
                corrida_actual
            )

            logs.append(
                f"Corrida detectada: {corrida_actual}"
            )

            corrida_actual = [
                datos[i]
            ]

    corridas.append(
        corrida_actual
    )

    logs.append(
        f"Corrida detectada: {corrida_actual}"
    )

    return corridas


# =========================================
# FUSIONAR
# =========================================

def fusionar(c1, c2, logs):

    resultado = []

    i = 0
    j = 0

    logs.append(
        "\nFusionando:"
    )

    logs.append(
        str(c1)
    )

    logs.append(
        str(c2)
    )

    while i < len(c1) and j < len(c2):

        if c1[i] <= c2[j]:

            resultado.append(
                c1[i]
            )

            i += 1

        else:

            resultado.append(
                c2[j]
            )

            j += 1

    while i < len(c1):

        resultado.append(
            c1[i]
        )

        i += 1

    while j < len(c2):

        resultado.append(
            c2[j]
        )

        j += 1

    logs.append(
        f"Resultado fusion: {resultado}\n"
    )

    return resultado


# =========================================
# FUSIONAR CORRIDAS
# =========================================

def fusionar_corridas(corridas, logs):

    fase = 1

    while len(corridas) > 1:

        logs.append(
            f"\n========== FASE {fase} ==========\n"
        )

        nuevas = []

        for i in range(
            0,
            len(corridas),
            2
        ):

            if i + 1 < len(corridas):

                fusion = fusionar(
                    corridas[i],
                    corridas[i + 1],
                    logs
                )

                nuevas.append(
                    fusion
                )

            else:

                nuevas.append(
                    corridas[i]
                )

        corridas = nuevas

        fase += 1

    return corridas[0]


# =========================================
# MEZCLA EQUILIBRADA
# =========================================

def mezcla_equilibrada(ruta_archivo):

    logs = []

    logs.append(
        "\n======================================"
    )

    logs.append(
        "         MEZCLA EQUILIBRADA"
    )

    logs.append(
        "======================================"
    )

    datos = leer_archivo(
        ruta_archivo
    )

    logs.append(
        "\nDatos originales:\n"
    )

    logs.append(
        str(datos)
    )

    logs.append(
        "\n========== CORRIDAS ==========\n"
    )

    corridas = detectar_corridas(
        datos,
        logs
    )

    resultado = fusionar_corridas(
        corridas,
        logs
    )

    logs.append(
        "\n========== RESULTADO FINAL ==========\n"
    )

    logs.append(
        str(resultado)
    )

    ruta_salida = (
        "resultado_mezcla_equilibrada.txt"
    )

    escribir_archivo(
        ruta_salida,
        resultado
    )

    logs.append(
        f"\nArchivo generado: {ruta_salida}"
    )

    return resultado, logs


# =========================================
# MAIN
# =========================================

if __name__ == "__main__":

    ruta = "datos.txt"

    if os.path.exists(ruta):

        resultado, logs = mezcla_equilibrada(
            ruta
        )

        for linea in logs:

            print(linea)

    else:

        print(
            "\nNo existe datos.txt\n"
        )
