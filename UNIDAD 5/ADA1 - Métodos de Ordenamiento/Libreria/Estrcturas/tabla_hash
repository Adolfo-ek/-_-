# ============================================
# TABLA HASH
# ============================================

class TablaHash:

    def __init__(self, tamaño=10):

        self.tamaño = tamaño

        self.tabla = [[] for _ in range(tamaño)]

    # ========================================
    # FUNCIÓN HASH
    # ========================================

    def funcion_hash(self, clave):

        return hash(clave) % self.tamaño

    # ========================================
    # INSERTAR
    # ========================================

    def insertar(self, clave, valor):

        indice = self.funcion_hash(clave)

        bucket = self.tabla[indice]

        for i, (k, v) in enumerate(bucket):

            if k == clave:

                bucket[i] = (clave, valor)

                return

        bucket.append((clave, valor))

    # ========================================
    # BUSCAR
    # ========================================

    def buscar(self, clave):

        indice = self.funcion_hash(clave)

        bucket = self.tabla[indice]

        for k, v in bucket:

            if k == clave:

                return v

        return None

    # ========================================
    # ELIMINAR
    # ========================================

    def eliminar(self, clave):

        indice = self.funcion_hash(clave)

        bucket = self.tabla[indice]

        for i, (k, v) in enumerate(bucket):

            if k == clave:

                del bucket[i]

                return True

        return False

    # ========================================
    # MOSTRAR
    # ========================================

    def mostrar(self):

        for i, bucket in enumerate(self.tabla):

            print(f"{i}: {bucket}")


# ============================================
# PRUEBAS
# ============================================

if __name__ == "__main__":

    tabla = TablaHash()

    tabla.insertar("nombre", "Adolfo")

    tabla.insertar("edad", 21)

    tabla.insertar("ciudad", "Mérida")

    print("\nTABLA HASH:")
    tabla.mostrar()

    print("\nBUSCAR 'nombre':")
    print(tabla.buscar("nombre"))

    print("\nELIMINAR 'edad':")
    print(tabla.eliminar("edad"))

    print("\nTABLA ACTUALIZADA:")
    tabla.mostrar()

    input("\nPresiona ENTER para cerrar...")
