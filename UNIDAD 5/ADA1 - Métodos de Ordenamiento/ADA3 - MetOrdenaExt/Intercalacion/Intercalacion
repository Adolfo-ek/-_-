def intercalacion(lista1, lista2):

    resultado = []

    i = 0
    j = 0

    while i < len(lista1) and j < len(lista2):

        if lista1[i] < lista2[j]:
            resultado.append(lista1[i])
            i += 1
        else:
            resultado.append(lista2[j])
            j += 1

    while i < len(lista1):
        resultado.append(lista1[i])
        i += 1

    while j < len(lista2):
        resultado.append(lista2[j])
        j += 1

    return resultado


# =========================
# EJEMPLO
# =========================

lista_a = [1, 3, 5, 7]
lista_b = [2, 4, 6, 8]

resultado = intercalacion(lista_a, lista_b)

print("Lista intercalada:")
print(resultado)
