def mezcla_equilibrada(lista):

    if len(lista) <= 1:
        return lista

    mitad = len(lista) // 2

    izquierda = mezcla_equilibrada(lista[:mitad])
    derecha = mezcla_equilibrada(lista[mitad:])

    return fusionar(izquierda, derecha)


def fusionar(izquierda, derecha):

    resultado = []

    while izquierda and derecha:

        if izquierda[0] < derecha[0]:
            resultado.append(izquierda.pop(0))
        else:
            resultado.append(derecha.pop(0))

    resultado.extend(izquierda)
    resultado.extend(derecha)

    return resultado


# =========================
# EJEMPLO
# =========================

datos = [50, 20, 40, 10, 30, 60]

print("Lista original:")
print(datos)

ordenada = mezcla_equilibrada(datos)

print("\nLista ordenada:")
print(ordenada)
