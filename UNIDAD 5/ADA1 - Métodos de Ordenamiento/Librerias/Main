from busqueda_binaria import BusquedaBinaria


datos = [1, 3, 5, 7, 9, 11, 13, 15]

print("Lista:")
print(datos)

# =========================
# BUSQUEDA ITERATIVA
# =========================

resultado = BusquedaBinaria.buscar_iterativo(datos, 7)

print("\nBusqueda Iterativa:")
print("Elemento encontrado en posicion:", resultado)

# =========================
# BUSQUEDA RECURSIVA
# =========================

resultado = BusquedaBinaria.buscar_recursivo(datos, 11)

print("\nBusqueda Recursiva:")
print("Elemento encontrado en posicion:", resultado)

# =========================
# BUSCAR TODOS
# =========================

datos2 = [1, 2, 2, 2, 3, 4, 5]

resultado = BusquedaBinaria.buscar_todos(datos2, 2)

print("\nBuscar Todos:")
print("Indices encontrados:", resultado)

# =========================
# BUSCAR MAS CERCANO
# =========================

resultado = BusquedaBinaria.buscar_mas_cercano(datos, 10)

print("\nBuscar Mas Cercano:")
print("Elemento mas cercano:", resultado)
